FROM node:24-bookworm-slim AS dependencies
WORKDIR /workspace
RUN npm install --global pnpm@11.24.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps ./apps
COPY packages ./packages
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile --filter @tcg/api... --filter @tcg/strapi... --filter @tcg/medusa... --filter @tcg/public-web...

FROM dependencies AS development
ENV NODE_ENV=development
RUN mkdir -p /workspace/apps/api/storage /workspace/apps/cms/public/uploads /workspace/apps/backend/static /workspace/apps/public-web/.next && find /workspace -name node_modules -prune -o -exec chown node:node {} +
USER node
WORKDIR /workspace/apps/api
EXPOSE 3333

FROM dependencies AS build
RUN pnpm --filter @tcg/api build

FROM build AS production
ENV NODE_ENV=production
RUN mkdir -p /workspace/apps/api/storage /workspace/apps/api/build/storage && find /workspace -name node_modules -prune -o -exec chown node:node {} +
USER node
WORKDIR /workspace/apps/api
EXPOSE 3333
CMD ["node", "build/bin/server.js"]
