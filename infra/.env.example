# Compose interpolation and storefront build-time values; copy to .env.
API_PORT=3333
CMS_PORT=1337
BACKEND_PORT=9000
PUBLIC_WEB_PORT=3000
# These URLs must resolve from both the browser and the public-web container.
NEXT_PUBLIC_API_URL=http://host.docker.internal:3333/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://host.docker.internal:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=eg
NEXT_PUBLIC_STRAPI_API_URL=http://host.docker.internal:1337
# Optional public settings; the current Docker build does not forward these as build arguments.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_KEY=
