NODE_ENV=development
APP_KEYS=replace-key-one,replace-key-two
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-with-32-character-secret
DATABASE_CLIENT=postgres
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_NAME=tcg_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me
DATABASE_SSL=false
MEDUSA_PUBLISHABLE_KEY=

# Compose overrides HOST, PORT, and MEDUSA_BACKEND_URL.
HOST=0.0.0.0
PORT=1337
MEDUSA_BACKEND_URL=http://backend:9000
# Only used when DATABASE_CLIENT=sqlite.
DATABASE_FILENAME=.tmp/data.db
