# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS base
WORKDIR /workspace
ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
FROM base AS fetch
ARG PNPM_NETWORK_CONCURRENCY=16
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/cache pnpm config set store-dir /pnpm/cache && pnpm fetch --ignore-scripts --network-concurrency=$PNPM_NETWORK_CONCURRENCY && cp -a /pnpm/cache /pnpm/store
FROM fetch AS build
COPY . .
RUN pnpm config set store-dir /pnpm/store && pnpm install --offline --frozen-lockfile --filter @tcg/medusa... && pnpm --filter @tcg/medusa build
FROM base AS runtime
COPY --from=fetch /pnpm/store /pnpm/store
COPY . .
RUN pnpm config set store-dir /pnpm/store && pnpm install --offline --prod --frozen-lockfile --filter @tcg/medusa... && rm -f .npmrc
COPY --from=build /workspace/apps/backend/.medusa /workspace/apps/backend/.medusa
