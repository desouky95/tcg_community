{
  "name": "tcg-community-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "catalog:",
    "eslint": "^9.39.4",
    "jiti": "catalog:",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "catalog:",
    "typescript": "catalog:typescript6"
  },
  "scripts": {
    "dev": "pnpm --filter=./apps/*  dev",
    "dev:public": "pnpm --filter @tcg/public-web dev",
    "dev:web": "pnpm --filter @tcg/web dev",
    "dev:api": "pnpm --filter @tcg/api dev",
    "build:public": "pnpm --filter @tcg/public-web build",
    "typecheck:public": "pnpm --filter @tcg/public-web typecheck",
    "build": "pnpm --recursive --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm --recursive --filter './packages/*' --filter './apps/*' run typecheck",
    "test": "pnpm --recursive --if-present --filter './packages/*' --filter './apps/*' run test",
    "backend:seed": "turbo --filter=@dtc/backend seed",
    "backend:dev": "turbo  --filter=@dtc/backend dev",
    "docker:start": "docker compose --env-file infra/.env -f infra/compose.yaml -f infra/compose.dev.yaml up --build"
  }
}
