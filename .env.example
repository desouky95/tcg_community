# Copy to .env for local Compose; import the same runtime keys in App Platform.
# Fill blank credentials before launch. Preserve existing signing/encryption keys.
# NEXT_PUBLIC_* and VITE_* are public BUILD inputs: also set GitHub repository variables.
# Apps read prefixed keys directly; the bundle filters namespaces without renaming keys.
# Reuse matching integration secrets across app namespaces where required; see deployment guide.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STRAPI_API_URL=
