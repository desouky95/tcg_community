{
  "name": "@tcg/strapi",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "node --env-file-if-exists=../../.env ./node_modules/@strapi/strapi/bin/strapi.js build",
    "console": "node --env-file-if-exists=../../.env ./node_modules/@strapi/strapi/bin/strapi.js console",
    "deploy": "node --env-file-if-exists=../../.env ./node_modules/@strapi/strapi/bin/strapi.js deploy",
    "dev": "NODE_ENV=development node --env-file-if-exists=../../.env ./node_modules/@strapi/strapi/bin/strapi.js develop",
    "develop": "NODE_ENV=development node --env-file-if-exists=../../.env ./node_modules/@strapi/strapi/bin/strapi.js develop",
    "start": "NODE_ENV=production node --env-file-if-exists=../../.env ./node_modules/@strapi/strapi/bin/strapi.js start",
    "strapi": "node --env-file-if-exists=../../.env ./node_modules/@strapi/strapi/bin/strapi.js",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "strapi:generate": "strapi-types generate --output packages/strapi-client  --format ts",
    "strapi:check": "strapi-types check --output ./src/strapi"
  },
  "dependencies": {
    "@medusajs/js-sdk": "2.22.1",
    "@strapi/database": "5.60.0",
    "@strapi/plugin-cloud": "5.60.0",
    "@strapi/plugin-documentation": "^5.61.0",
    "@strapi/plugin-users-permissions": "5.60.0",
    "@strapi/provider-upload-aws-s3": "^5.63.0",
    "@strapi/strapi": "5.60.0",
    "pg": "8.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "strapi-plugin-country-select": "^2.1.0",
    "strapi-plugin-croppable-media": "^1.0.1",
    "strapi-typed-client": "^2.4.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "prismjs": "^1.30.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "1df81d7d-3faa-453b-9799-ee2e159459cd",
    "installId": "6bb52b05c82c67126329fb63420b4b41f8ddd44fb0ed24924a8040d8c11899c4"
  }
}
