# Configure these keys in the repository root .env (see ../../.env.example).
API_WEB_ORIGINS=http://localhost:3000,http://localhost:5173
API_SESSION_COOKIE_DOMAIN=
API_MEDUSA_INTERNAL_URL=http://localhost:9000
API_MEDUSA_SERVICE_KEY=
API_CARD_CATALOG_API_KEY=
# Keep false until the dedicated swapping launch.
API_SWAPS_ENABLED=false
API_SCRAPER_TRIGGER_TOKEN=
API_FIRECRAWL_API_KEY=
API_DRIVE_DISK=fs
API_APP_KEY=
API_SESSION_DRIVER=cookie
API_FACEBOOK_CLIENT_ID=placeholder
API_FACEBOOK_CLIENT_SECRET=placeholder
# Register ${APP_URL}/api/v1/auth/oauth/facebook/callback with Facebook Login.
API_PUBLIC_WEB_URL=http://localhost:3000
API_COLLECTOR_APP_URL=http://localhost:5173

# Google OAuth web application (server only)
API_GOOGLE_CLIENT_ID=
API_GOOGLE_CLIENT_SECRET=

# Use the same independently generated 32+ character secret on API and public server.
API_SOCIAL_AUTH_BRIDGE_SECRET=