# Configure these keys in the repository root .env (see ../../.env.example).
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
# Use the Compose service name for Next.js server-side requests in Docker.
PUBLIC_WEB_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Medusa region ID (reg_...) or ISO 2 country code used for price resolution
NEXT_PUBLIC_DEFAULT_REGION=eg
# Production app URL: https://app.nextpull.com

# Use the same independently generated 32+ character secret on API and public server.
PUBLIC_WEB_SOCIAL_AUTH_BRIDGE_SECRET=
PUBLIC_WEB_BETTER_AUTH_SECRET=
PUBLIC_WEB_BETTER_AUTH_URL=http://localhost:3000
PUBLIC_WEB_GOOGLE_CLIENT_ID=
PUBLIC_WEB_GOOGLE_CLIENT_SECRET=
PUBLIC_WEB_FACEBOOK_CLIENT_ID=
PUBLIC_WEB_FACEBOOK_CLIENT_SECRET=
